[0.446, "o", "\u001b[33mWarning:\u001b[0m node@24 was installed but not linked because node is already linked.\r\nTo link this version, run:\r\n  brew link node@24\r\n"]
[0.375, "o", "🍺  /opt/homebrew/Cellar/node@24/24.21.0: 2,103 files, 82.6MB\r\n"]
[0.033, "o", "\u001b[32m==>\u001b[0m \u001b[1mCaveats\u001b[0m\r\n"]
[0.000, "o", "\u001b[34m==>\u001b[0m \u001b[1mnode@24\u001b[0m\r\n"]
[0.000, "o", "node@24 is keg-only, which means it was not symlinked into /opt/homebrew,\r\nbecause this is an alternate version of another formula.\r\n\r\nIf you need to have node@24 first in your PATH, run:\r\n  echo 'export PATH=/opt/homebrew/opt/node@24/bin:$PATH' >> /Users/liampestrella/.zshrc\r\n\r\nFor compilers to find node@24 you may need to set:\r\n  export LDFLAGS=-L/opt/homebrew/opt/node@24/lib\r\n  export CPPFLAGS=-I/opt/homebrew/opt/node@24/include\r\n\r\nThe following node@24 executables are shadowed by other linked Homebrew commands:\r\n  node (shadowed by /opt/homebrew/bin/node from node)\r\nRunning these by name will not invoke the version provided by this formula.\r\nRun `brew link node@24` to switch the active version to this keg.\r\nDisable this behaviour by setting `HOMEBREW_NO_PATH_SHADOW_CHECK=1`.\r\nHide these hints with `HOMEBREW_NO_ENV_HINTS=1` (see `man brew`).\r\n"]
[0.023, "o", "\u001b[1m\u001b[7m%\u001b[27m\u001b[1m\u001b[0m                                                                                                                                                  \r \r"]
[0.000, "o", "\r\u001b[0m\u001b[27m\u001b[24m\u001b[J(venv) liampestrella@Liams-MacBook-Air-2 cloudcmd % \u001b[K\u001b[?2004h"]
[0.929, "o", "\u001b[7mbrew unlink node\u001b[27m\r\r\n\u001b[7mbrew link --overwrite --force node@24\u001b[27m\u001b[K"]
