[1499.335071, "o", "\u001b[H\u001b(B\u001b[0;7m  GNU nano 8.4                                               gitea.yml                                                        \u001b[1;125H\u001b(B\u001b[m\r\u001b[37d\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Help\u001b[37;16H\u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out   \u001b(B\u001b[0;7m^F\u001b(B\u001b[m Where Is    \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut\u001b[37;61H\u001b(B\u001b[0;7m^T\u001b(B\u001b[m Execute     \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Location    \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\u001b[106G\u001b(B\u001b[0;7mM-A\u001b(B\u001b[m Set Mark\r\u001b[38d\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[38;16H\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File   \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace     \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste\u001b[61G\u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify     \u001b(B\u001b[0;7m^/\u001b(B\u001b[m Go To Line  \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\u001b[106G\u001b(B\u001b[0;7mM-6\u001b(B\u001b[m Copy\r\u001b[2d\u001b(B\u001b[0;1m\u001b[38;5;38m---\r\u001b[3d\u001b[33m- \u001b(B\u001b[0m\u001b[92mname\u001b[39m: \u001b(B\u001b[mInstall Gitea and a host-based Actions runner for Lab7 - Liam Pestrella\u001b[4;3H\u001b[92mhosts\u001b[39m: \u001b(B\u001b[mlocal\u001b[5;3H\u001b[92mbecome\u001b[39m: \u001b[95mtrue\u001b[7;3H\u001b[92mvars\u001b[39m:\u001b[8;5H\u001b[92mgitea_version\u001b[39m: \u001b[95m\"28.3.0\"\u001b[9;5H\u001b[92mrunner_version\u001b[39m: \u001b[95m\"5.2.0\"\u001b[11;5H\u001b[92mbinary_arch\u001b[39m:\u001b(B\u001b[0;1m\u001b[38;5;38m >-\u001b[12;7H"]
[1499.335214, "o", "\u001b(B\u001b[0m\u001b[33m{{\u001b[39m\u001b(B\u001b[m \u001b[33m{\u001b[95m'x86_64'\u001b[39m: \u001b[95m'amd64'\u001b[39m, \u001b[95m'aarch64'\u001b[39m: \u001b[95m'arm64'\u001b[33m}[\u001b[39m\u001b(B\u001b[mansible_architecture\u001b[33m]\u001b[39m\u001b(B\u001b[m \u001b[33m}}\u001b[14;4H\u001b(B\u001b[0m\u001b[3m\u001b[36m # Open Gitea in the browser INSIDE Debian using this URL.\u001b[15;5H\u001b(B\u001b[0m\u001b[23m\u001b[92mgitea_url\u001b[39m: \u001b[95m\"http://localhost:3000/\"\u001b[17;5H\u001b[92mgitea_binary_url\u001b[39m:\u001b(B\u001b[0;1m\u001b[38;5;38m >-\u001b[18;7H\u001b[39m\u001b(B\u001b[mhttps://dl.gitea.com/gitea/\u001b[33m{{\u001b[39m\u001b(B\u001b[m gitea_version \u001b[33m}}\u001b[39m\u001b(B\u001b[m/gitea-\u001b[33m{{\u001b[39m\u001b(B\u001b[m gitea_version \u001b[33m}}\u001b[39m\u001b(B\u001b[m-linux-\u001b[33m{{\u001b[39m\u001b(B\u001b[m binary_arch \u001b[33m}}\u001b[20;5H\u001b[92mrunner_binary_url\u001b[39m:\u001b(B\u001b[0;1m\u001b[38;5;38m >-\u001b[21;7H\u001b[39m\u001b(B\u001b[mhttps://dl.gitea.com/gitea-runner/\u001b[33m{{\u001b[39m\u001b(B\u001b[m runner_version \u001b[33m}}\u001b[39m\u001b(B\u001b[m/gitea-runner-\u001b[33m{{\u001b[39m\u001b(B\u001b[m runner_version \u001b[33m}}\u001b[39m\u001b(B\u001b[m-linux-\u001b[33m{{\u001b[39m\u001b(B\u001b[m binary_arch \u001b[33m}}\u001b[23;3H\u001b[92mtasks\u001b[39m:\r\u001b[24d\u001b(B\u001b[0;1m\u001b[33m    - \u001b(B\u001b[0m\u001b[92mname\u001b[39m: \u001b(B\u001b[mCheck supported VM architecture\u001b[25;7H\u001b[92mansible.builtin.assert\u001b[39m:\u001b[26;9H\u001b[92mthat\u001b[39m:\u001b[27;10H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u001b(B\u001b[mansible_architecture in \u001b[33m[\u001b[95m'x86_64'\u001b[39m, \u001b[95m'aarch64'\u001b[33m]\u001b[28;9H\u001b[92mfail_msg\u001b[39m: \u001b[95m\"This playbook supports AMD64 and ARM64 Debian VMs.\"\r\u001b[30d\u001b(B\u001b[0;1m\u001b[33m    - \u001b(B\u001b[0m\u001b[92mname\u001b[39m: \u001b(B\u001b[mInstall dependencies and tools for host jobs\u001b[31;7H\u001b[92mansible.builtin.apt\u001b[39m:\u001b[32;9H\u001b[92mname\u001b[39m:\u001b[33;10H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u001b(B\u001b[mgit\u001b[34;10H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u001b(B\u001b[msqlite3\u001b[35;10H\u001b(B\u001b[0;1m\u001b[33m\u001b[1K - \u001b[39m\u001b(B\u001b[mca-certificates\r\u001b[2d\u001b[?12l\u001b[?25h"]
