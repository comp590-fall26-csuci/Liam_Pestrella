[2988.119966, "o", "name: C/C++ CI Lab 4\r\n\r\non:\r\n  push:\r\n    branches: [ \"lab4\" ]\r\n  pull_request:\r\n    branches: [ \"lab4\", \"main\" ]\r\n\r\njobs:\r\n  build:\r\n    runs-on: ubuntu-latest\r\n\r\n    steps:\r\n    - name: Checkout code\r\n      uses: actions/checkout@v4\r\n    - name: Build\r\n      run: make\r\n      working-directory: ./lab4/lab3/590MakefileLab\r\n    - name: Run tests to verify correct output\r\n      working-directory: ./lab4/lab3/590MakefileLab\r\n      run: |\r\n        # run tests to verify fibonacci output and golden ratio\r\n        OUTPUT=$(./fibonacci)\r\n        echo \"$OUTPUT\"\r\n        echo \"$OUTPUT\" | grep -qw \"55\"\r\n        echo \"$OUTPUT\" | grep -q \"1.618034\"\r\n\r\n"]
