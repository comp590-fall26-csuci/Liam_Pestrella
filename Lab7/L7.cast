[1889.514748, "o", "\u001b]0;liam-mail@debian-lab: ~/Liam_Pestrella/Lab7\u0007\u001b[01;32mliam-mail@debian-lab\u001b[00m:\u001b[01;34m~/Liam_Pestrella/Lab7\u001b[00m$ "]
[1890.134569, "o", "nano gitea.yml"]
[1890.451763, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\u001b[1Pcat hosts.ini"]
[1890.708156, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\bls\u001b[K"]
[1891.081103, "o", "\b\bsudo python3 - <<'PY'\r\n\rimport configparser\r\n\r\n\rconfig = configparser.ConfigParser(interpolation=None)\r\n\rwith open(\"/etc/gitea/app.ini\") as f:\r\n\r    config.read_string(\"[DEFAULT]\\n\" + f.read())\r\n\r\n\rprint(\"OAuth2 section exists:\", config.has_section(\"oauth2\"))\r\n\rprint(\"Signing algorithm:\", config.get(\"oauth2\", \"JWT_SIGNING_ALGORITHM\", fallback=\"not set\"))\r\n\rsecret = config.get(\"oauth2\", \"JWT_SECRET\", fallback=\"\").strip()\r\n\rprint(\"JWT secret present:\", bool(secret))\r\n\rprint(\"JWT secret length:\", len(secret))\r\n\rPY\r\n\r"]
[1891.705254, "o", "\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[4Pconfig.read(\"/etc/gitea/app.ini\")\r\n\r                                                \r\n\rprint(\"OAuth2 section exists:\", config.has_section(\"oauth2\"))\r\n\r\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[CSigning algorithm:\", config.get(\"oauth2\", \"JWT_SIGNING_ALGORITHM\", fallback=\"not set\"))\r\n\r\u001b[30Psecret = config.get(\"oauth2\", \"JWT_SECRET\", fallback=\"\").strip()\r\n\r\u001b[22Pprint(\"JWT secret present:\", bool(secret))\r\n\r\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[2Plength:\", len(secret))\r\n\rPY                                      \r\n\r\u001b[K\r\n\r\u001b[K\u001b[A"]
[1892.176653, "o", "\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[6Pgitea --version\r\n\r\u001b[K\r\n\r\u001b[K\r\n\r\u001b[K\r\n\r\u001b[K\r\n\r\u001b[K\r\n\r\u001b[K\r\n\r\u001b[K\r\n\r\u001b[K\r\n\r\u001b[K\r\n\r\u001b[K\r\n\r\u001b[K\r\n\r\u001b[K\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C"]
[1892.334488, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\u001b[1Pnano gitea.yml"]
[1892.477541, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\bsudo journalctl -u gitea -n 25 --no-pager"]
[1893.253725, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\bansible-playbook -i hosts.ini gitea.yml -K"]
[1893.559252, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\u001b[28Pnano gitea.yml"]
