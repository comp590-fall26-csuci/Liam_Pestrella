[1558.844192, "o", "\u001b[7msudo python3 - <<'PY'\u001b[27m\r\n\r\u001b[7mimport configparser\u001b[27m\r\n\r\n\r\u001b[7mconfig = configparser.ConfigParser(interpolation=None)\u001b[27m\r\n\r\u001b[7mconfig.read(\"/etc/gitea/app.ini\")\u001b[27m\r\n\r\n\r\u001b[7mprint(\"OAuth2 section exists:\", config.has_section(\"oauth2\"))\u001b[27m\r\n\r\u001b[7mprint(\"Signing algorithm:\", config.get(\"oauth2\", \"JWT_SIGNING_ALGORITHM\", fallback=\"not set\"))\u001b[27m\r\n\r\u001b[7msecret = config.get(\"oauth2\", \"JWT_SECRET\", fallback=\"\").strip()\u001b[27m\r\n\r\u001b[7mprint(\"JWT secret present:\", bool(secret))\u001b[27m\r\n\r\u001b[7mprint(\"JWT secret length:\", len(secret))\u001b[27m\r\n\r\u001b[7mPY\u001b[27m"]
[1560.084095, "o", "\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\r\u001b]0;liam-mail@debian-lab: ~/Liam_Pestrella/Lab7\u0007\u001b[01;32mliam-mail@debian-lab\u001b[00m:\u001b[01;34m~/Liam_Pestrella/Lab7\u001b[00m$ sudo python3 - <<'PY'\r\n"]
[1560.085261, "o", "\rimport configparser\r\n\r\n\rconfig = configparser.ConfigParser(interpolation=None)\r\n\rconfig.read(\"/etc/gitea/app.ini\")\r\n\r\n\rprint(\"OAuth2 section exists:\", config.has_section(\"oauth2\"))\r\n\rprint(\"Signing algorithm:\", config.get(\"oauth2\", \"JWT_SIGNING_ALGORITHM\", fallback=\"not set\"))\r\n\rsecret = config.get(\"oauth2\", \"JWT_SECRET\", fallback=\"\").strip()\r\n\rprint(\"JWT secret present:\", bool(secret))\r\n\rprint(\"JWT secret length:\", len(secret))"]
