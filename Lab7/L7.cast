[3068.085808, "o", "\r\u001b[2d\u001b[92mname\u001b[39m: \u001b(B\u001b[mC/C++ CI Lab 4\r\u001b[4d\u001b[92mon\u001b[39m:\u001b[5d\b\u001b[92mpush\u001b[39m:\u001b[6;5H\u001b[92mbranches\u001b[39m: \u001b[33m[\u001b[39m\u001b(B\u001b[m \u001b[95m\"lab4\"\u001b[39m\u001b(B\u001b[m \u001b[33m]\u001b[7;3H\u001b[92mpull_request\u001b[39m:\u001b[8;5H\u001b[92mbranches\u001b[39m: \u001b[33m[\u001b[39m\u001b(B\u001b[m \u001b[95m\"lab4\"\u001b[39m, \u001b[95m\"main\"\u001b[39m\u001b(B\u001b[m \u001b[33m]\r\u001b[10d\u001b[92mjobs\u001b[39m:\u001b[11;3H\u001b[92mbuild\u001b[39m:\u001b[12;5H\u001b[92mruns-on\u001b[39m: \u001b(B\u001b[mubuntu-latest\u001b[14;5H\u001b[92msteps\u001b[39m:\r\u001b[15d\u001b(B\u001b[0;1m\u001b[33m    - \u001b(B\u001b[0m\u001b[92mname\u001b[39m: \u001b(B\u001b[mCheckout code\u001b[16;7H\u001b[92muses\u001b[39m: \u001b(B\u001b[mactions/checkout@v4\r\u001b[17d\u001b(B\u001b[0;1m\u001b[33m    - \u001b(B\u001b[0m\u001b[92mname\u001b[39m: \u001b(B\u001b[mBuild\u001b[18;7H\u001b[92mrun\u001b[39m: \u001b(B\u001b[mmake\u001b[19;7H\u001b[92mworking-directory\u001b[39m: \u001b(B\u001b[m./lab4/lab3/590MakefileLab\r\u001b[20d\u001b(B\u001b[0;1m\u001b[33m    - \u001b(B\u001b[0m\u001b[92mname\u001b[39m: \u001b(B\u001b[mRun tests to verify correct output\u001b[21;7H\u001b[92mworking-directory\u001b[39m: \u001b(B\u001b[m./lab4/lab3/590MakefileLab\u001b[22;7H\u001b[92mrun\u001b[39m:\u001b(B\u001b[0;1m\u001b[38;5;38m |\u001b[23;8H\u001b(B\u001b[0m\u001b[3m\u001b[36m # run tests to verify fibonacci output and golden ratio\u001b[24;9H\u001b[39m\u001b(B\u001b[mOUTPUT=$(./fibonacci)\u001b[25;9Hecho \u001b[95m\"$OUTPUT\"\u001b[26;9H\u001b[39m\u001b(B\u001b[mecho \u001b[95m\"$OUTPUT\"\u001b[39m\u001b(B\u001b[m | grep -qw \u001b[95m\"55\"\u001b[27;9H\u001b[39m\u001b(B\u001b[mecho \u001b[95m\"$OUTPUT\"\u001b[39m\u001b(B\u001b[m | grep -q \u001b[95m\"1.618034\"\r\u001b[2d\u001b[39m\u001b(B\u001b[m\u001b[?12l\u001b[?25h"]
