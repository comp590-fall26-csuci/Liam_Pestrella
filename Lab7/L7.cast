[1729.065955, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\b\u001b[27Pnano gitea.yml"]
[1729.191037, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\bgitea --version"]
[1729.318803, "o", "\b\b\b\b\b\b\b\b\b\b\b\b\b\b\bsudo python3 - <<'PY'\r\n\rimport configparser\r\n\r\n\rconfig = configparser.ConfigParser(interpolation=None)\r\n\rconfig.read(\"/etc/gitea/app.ini\")\r\n\r\n\rprint(\"OAuth2 section exists:\", config.has_section(\"oauth2\"))\r\n\rprint(\"Signing algorithm:\", config.get(\"oauth2\", \"JWT_SIGNING_ALGORITHM\", fallback=\"not set\"))\r\n\rsecret = config.get(\"oauth2\", \"JWT_SECRET\", fallback=\"\").strip()\r\n\rprint(\"JWT secret present:\", bool(secret))\r\n\rprint(\"JWT secret length:\", len(secret))\r\n\rPY\r\n\r"]
[1729.596121, "o", "\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[Awith open(\"/etc/gitea/app.ini\") as f:\r\n\r    config.read_string(\"[DEFAULT]\\n\" + f.read())\r\n\r                                                             \r\n\r\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[33POAuth2 section exists:\", config.has_section(\"oauth2\"))\r\n\rprint(\"Signing algorithm:\", config.get(\"oauth2\", \"JWT_SIGNING_ALGORITHM\", fallback=\"not set\"))\r\n\rsecret = config.get(\"oauth2\", \"JWT_SECRET\", fallback=\"\").strip()\r\n\r\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[Cpresent:\", bool(secret))\r\n\rprint(\"JWT secret length:\", len(secret))\r\n\rPY\r\n\r"]
